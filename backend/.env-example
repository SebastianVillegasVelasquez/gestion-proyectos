# ── App ─────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://bitacora.objdigital.com.co"]

# ── Database ────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# ── Security ────────────────────────
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email ───────────────────────────
# Proveedor de envío: "resend" (producción) | "smtp" (legado) | "log" (no envía).
# Si al proveedor elegido le faltan credenciales, se degrada a "log" y nada se
# rompe (útil en local).
EMAIL_PROVIDER=resend
# Resend — API key del dominio verificado bitacora.objdigital.com.co.
# NUNCA la commitees: va en el .env de producción y como secret en GitHub Actions.
RESEND_API_KEY=
# Remitente. Debe pertenecer a un dominio verificado en Resend.
EMAIL_FROM=Bitácora OBJ <no-reply@bitacora.objdigital.com.co>
# SMTP directo — LEGADO. Solo se usa con EMAIL_PROVIDER=smtp. Con Gmail,
# SMTP_PASSWORD es un App Password de 16 caracteres, no la contraseña real.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# URL pública del frontend para los enlaces dentro de los correos (sin barra final).
APP_PUBLIC_URL=https://bitacora.objdigital.com.co

# ── Tareas atrasadas ────────────────
OVERDUE_SCAN_ENABLED=true
OVERDUE_SCAN_INTERVAL_HOURS=6

# ── Recordatorios personales ────────
REMINDERS_SCAN_ENABLED=true
REMINDERS_SCAN_INTERVAL_MINUTES=5

# ── OpenAI ──────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Super admin sembrado al iniciar; define una contraseña fuerte por entorno
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=

# Developer (rol técnico: todo + bandeja de feedback). Sin contraseña no se crea.
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=
