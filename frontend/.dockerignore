# Control de versiones
.git
.gitignore

# Dependencias (se reinstalan dentro de la imagen con pnpm)
node_modules
**/node_modules

# Build previo en local (se genera dentro de la imagen)
dist
build
.vite

# Variables de entorno locales
.env.*
!.env.example

# Cachés y cobertura
coverage
.eslintcache
.cache

# Editores / IDE
.vscode
.idea
*.swp

# SO
.DS_Store
Thumbs.db

# Archivos de test (el builder no los necesita para compilar)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
src/test

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker (no se necesita dentro de la imagen)
Dockerfile
.dockerignore

# Configuración de herramientas de desarrollo (no afectan el build de Vite)
eslint.config.js
components.json

# Documentación
README.md
*.md

# Lockfile alternativo (el Dockerfile usa pnpm-lock.yaml)
package-lock.json
