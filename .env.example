# =============================================================================
#  Bitácora OBJ — plantilla de variables de entorno
# =============================================================================
#  Copia este archivo y rellena los valores reales:
#
#     cp .env.example .env                     # raíz  → compose (db, redis)
#     cp .env.example backend/.env             # backend (FastAPI)
#     cp .env.example frontend/.env            # frontend (Vite)
#
#  Cada bloque indica en qué archivo se consume. En producción, los valores
#  marcados con «SECRETO» NUNCA se commitean: van en el .env del servidor y
#  como *secrets* en GitHub Actions.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  RAÍZ  →  ./.env   (lo lee docker compose para los contenedores db y frontend)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=bitacora_db
POSTGRES_USER=bitacora
POSTGRES_PASSWORD=                       # SECRETO — contraseña fuerte por entorno


# ─────────────────────────────────────────────────────────────────────────────
#  BACKEND  →  ./backend/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production                       # development | production
DEBUG=false
LOG_LEVEL=INFO
# Orígenes permitidos para CORS. JSON array o lista separada por comas.
CORS_ORIGINS=["https://bitacora.objdigital.com.co"]

# ── Base de datos ────────────────────────────────────────────────────────────
# En compose el host es el nombre del servicio (`db`); en un servidor sin
# docker, el host/puerto reales de Postgres.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=bitacora_db               # = POSTGRES_DB
DATABASE_USER=bitacora                  # = POSTGRES_USER
DATABASE_PASSWORD=                      # SECRETO — = POSTGRES_PASSWORD

# ── Seguridad / JWT ──────────────────────────────────────────────────────────
SECRET_KEY=                             # SECRETO — 64+ hex aleatorios (openssl rand -hex 32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Correo transaccional ─────────────────────────────────────────────────────
# resend (producción) · smtp (legado) · log (no envía, solo registra).
# Si al proveedor elegido le faltan credenciales, se degrada a `log` solo.
EMAIL_PROVIDER=resend
RESEND_API_KEY=                         # SECRETO — API key del dominio verificado en Resend
EMAIL_FROM=Bitácora OBJ <no-reply@bitacora.objdigital.com.co>
# URL pública del frontend (SIN barra final): con ella se arman los enlaces
# ("abrir tarea", "revisar entrega", "entrar") y el <img> del logo de TODOS los
# correos. En el servidor debe apuntar al dominio real y el build del frontend
# debe publicar `public/logo-email.jpg` en esa raíz (…/logo-email.jpg). Verifícalo
# con POST /api/v1/dev/email-test: la respuesta trae `resolved_logo_url` y
# `logo_reachable`.
APP_PUBLIC_URL=https://bitacora.objdigital.com.co
# SMTP directo — LEGADO, solo con EMAIL_PROVIDER=smtp. Con Gmail, SMTP_PASSWORD
# es un App Password de 16 caracteres (sin espacios), no la contraseña real.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                          # SECRETO (si se usa smtp)
SMTP_TLS=true

# ── Barridos periódicos ──────────────────────────────────────────────────────
# Tareas atrasadas: notificación + correo de aviso.
OVERDUE_SCAN_ENABLED=true
OVERDUE_SCAN_INTERVAL_HOURS=6
# Recordatorios personales: notificación y/o correo.
REMINDERS_SCAN_ENABLED=true
REMINDERS_SCAN_INTERVAL_MINUTES=5

# ── OpenAI (opcional) ────────────────────────────────────────────────────────
OPENAI_API_KEY=                         # SECRETO — vacío = funciones IA desactivadas
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# ── Redis / broadcaster de WebSockets ────────────────────────────────────────
# En compose: redis://redis:6379. Necesario si hay más de un worker del backend.
REDIS_URL=redis://redis:6379
USE_REDIS_AS_BROADCASTER=false

# ── Cuentas sembradas al iniciar ─────────────────────────────────────────────
# Sin contraseña, la cuenta no se crea. Define contraseñas fuertes por entorno.
SUPERADMIN_EMAIL=superadmin@objdigital.com
SUPERADMIN_PASSWORD=                    # SECRETO
SUPERADMIN_NAME=Super
SUPERADMIN_LAST_NAME=Admin
# Rol técnico: todos los permisos + bandeja de feedback + prueba de correo.
DEVELOPER_EMAIL=developer@objdigital.com
DEVELOPER_PASSWORD=                     # SECRETO
DEVELOPER_NAME=Dev
DEVELOPER_LAST_NAME=OBJ
# Equipo OBJ Digital — se siembran SOLO cuando APP_ENV=production.
ANA_EMAIL=ana@objdigital.com
ANA_PASSWORD=                           # SECRETO
JORGE_EMAIL=jorge@objdigital.com
JORGE_PASSWORD=                         # SECRETO
JHON_EMAIL=jhon@objdigital.com
JHON_PASSWORD=                          # SECRETO
SEBASTIAN_EMAIL=sebastian@objdigital.com
SEBASTIAN_PASSWORD=                     # SECRETO


# ─────────────────────────────────────────────────────────────────────────────
#  FRONTEND  →  ./frontend/.env   (Vite las inyecta en el build; van al bundle,
#  así que NO pongas secretos aquí)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_URL=/api/v1
VITE_WS_URL=wss://bitacora.objdigital.com.co/api/v1/ws/notifications
